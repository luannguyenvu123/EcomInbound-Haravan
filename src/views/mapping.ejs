<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Mapping</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/enterprise.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="https://app.hstatic.net/smes/uploads/63a4f573-85d8-4bc4-bf83-8b66b14ddc62.png" alt="Logo" height="32">
                <span>Inbound WMS</span>
            </a>
            <div class="d-flex align-items-center">
                <a href="/" class="btn btn-outline-light btn-sm me-2">
                    <i class="bi bi-house me-1"></i>Trang chủ
                </a>
                <a href="/mapping" class="btn btn-light btn-sm">
                    <i class="bi bi-diagram-3 me-1"></i>Mapping
                </a>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <div id="toast-container" style="position:fixed;top:80px;right:20px;z-index:1050;"></div>

        <div class="page-header">
            <h1 class="page-title">Quản Lý Mapping</h1>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-number"><%= mappings.length %></div>
                    <div class="stat-label">Tổng số mapping</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-number"><%= mappings.filter(m => m.Child.startsWith('3N')).length %></div>
                    <div class="stat-label">Mã 3N</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-number"><%= mappings.filter(m => m.Child.startsWith('1N')).length %></div>
                    <div class="stat-label">Mã 1N</div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-plus-circle me-2 text-success"></i>Thêm Mapping mới</h6>
                    </div>
                    <div class="card-body">
                        <form action="/mapping/add" method="post">
                            <div class="mb-3">
                                <label class="form-label">Mã con</label>
                                <input type="text" name="child" class="form-control" placeholder="VD: 3NMIGHPTTGC02N" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Mã cha</label>
                                <input type="text" name="parent" class="form-control" placeholder="VD: 1NMIGVFTTGC02N" required>
                            </div>
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-plus-lg me-1"></i>Thêm mới
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-upload me-2 text-primary"></i>Import từ file Excel</h6>
                    </div>
                    <div class="card-body">
                        <div class="import-section">
                            <form action="/mapping/import" method="post" enctype="multipart/form-data">
                                <div class="section-title">Chọn file (.xlsx)</div>
                                <div class="input-group">
                                    <input type="file" name="mappingFile" class="form-control" accept=".xlsx" required>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-cloud-upload me-1"></i>Import
                                    </button>
                                </div>
                                <small class="text-muted mt-2 d-block">
                                    <i class="bi bi-info-circle me-1"></i>
                                    File phải có định dạng: Cột B = mã cha, Cột C = mã con
                                </small>
                            </form>

                            <div class="template-download">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div>
                                        <i class="bi bi-file-earmark-excel text-success me-2"></i>
                                        <span class="fw-medium">Tải file mẫu</span>
                                    </div>
                                    <a href="/mapping/template" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-download me-1"></i>Tải về
                                    </a>
                                </div>
                                <small class="text-muted d-block mt-1">
                                    File mẫu có sẵn 3 dòng dữ liệu mẫu để tham khảo
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-table me-2"></i>Danh sách Mapping</h6>
            </div>
            <div class="card-body p-0">
                <% if (mappings.length > 0) { %>
                    <div class="table-responsive">
                        <table id="mappingTable" class="table table-hover mb-0" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Mã con</th>
                                    <th>Mã cha</th>
                                    <th style="width:170px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% mappings.forEach(function(item, index) { %>
                                    <tr id="row-<%= index %>">
                                        <td>
                                            <span class="view-mode"><span class="code-badge"><%= item.Child %></span></span>
                                            <input type="text" name="newChild" class="form-control form-control-sm edit-mode" value="<%= item.Child %>" style="display:none;">
                                        </td>
                                        <td>
                                            <span class="view-mode"><span class="code-badge"><%= item.Parent %></span></span>
                                            <input type="text" name="newParent" class="form-control form-control-sm edit-mode" value="<%= item.Parent %>" style="display:none;">
                                        </td>
                                        <td>
                                            <span class="view-mode">
                                                <div class="action-btns">
                                                    <button type="button" class="btn btn-outline-primary btn-icon" onclick="toggleEdit(<%= index %>)">
                                                        <i class="bi bi-pencil"></i>Sửa
                                                    </button>
                                                    <form action="/mapping/delete" method="post" style="display:inline;">
                                                        <input type="hidden" name="child" value="<%= item.Child %>">
                                                        <button type="submit" class="btn btn-outline-danger btn-icon" onclick="return confirm('Xóa <%= item.Child %>?')">
                                                            <i class="bi bi-trash"></i>Xóa
                                                        </button>
                                                    </form>
                                                </div>
                                            </span>
                                            <span class="edit-mode" style="display:none;">
                                                <div class="action-btns">
                                                    <form action="/mapping/update" method="post" style="display:inline;">
                                                        <input type="hidden" name="oldChild" value="<%= item.Child %>">
                                                        <input type="hidden" name="newChild" class="new-child-input">
                                                        <input type="hidden" name="newParent" class="new-parent-input">
                                                        <button type="submit" class="btn btn-success btn-icon">
                                                            <i class="bi bi-check-lg"></i>Lưu
                                                        </button>
                                                    </form>
                                                    <button type="button" class="btn btn-secondary btn-icon" onclick="cancelEdit(<%= index %>)">
                                                        <i class="bi bi-x-lg"></i>Hủy
                                                    </button>
                                                </div>
                                            </span>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p class="mb-1">Chưa có dữ liệu Mapping</p>
                        <small>Thêm mapping mới hoặc import từ file Excel</small>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        function toggleEdit(index) {
            const row = document.getElementById('row-' + index);
            row.querySelectorAll('.view-mode').forEach(el => el.style.display = 'none');
            row.querySelectorAll('.edit-mode').forEach(el => el.style.display = 'inline');
        }

        function cancelEdit(index) {
            const row = document.getElementById('row-' + index);
            row.querySelectorAll('.view-mode').forEach(el => el.style.display = 'inline');
            row.querySelectorAll('.edit-mode').forEach(el => el.style.display = 'none');
        }

        document.querySelectorAll('input[name="newChild"]').forEach(input => {
            input.addEventListener('input', function() {
                const hiddenInput = this.closest('tr').querySelector('.new-child-input');
                if (hiddenInput) hiddenInput.value = this.value;
            });
        });

        document.querySelectorAll('input[name="newParent"]').forEach(input => {
            input.addEventListener('input', function() {
                const hiddenInput = this.closest('tr').querySelector('.new-parent-input');
                if (hiddenInput) hiddenInput.value = this.value;
            });
        });

        function showToast(message, type) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `alert alert-${type} alert-dismissible fade show`;
            toast.style.cssText = 'min-width:300px;';
            toast.innerHTML = `
                <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 5000);
        }

        const params = new URLSearchParams(window.location.search);
        if (params.get('import') === 'success') {
            showToast(`Import thành công. Đã thêm ${params.get('count') || ''} mapping.`, 'success');
            window.history.replaceState({}, '', '/mapping');
        } else if (params.get('import') === 'error') {
            showToast('Import thất bại. Vui lòng kiểm tra lại file.', 'danger');
            window.history.replaceState({}, '', '/mapping');
        }

        $(document).ready(function() {
            $('#mappingTable').DataTable({
                language: {
                    search: "",
                    searchPlaceholder: "Tìm mã con hoặc mã cha...",
                    lengthMenu: "_MENU_ dòng / trang",
                    info: "_START_–_END_ / _TOTAL_ bản ghi",
                    infoEmpty: "0 bản ghi",
                    infoFiltered: "(lọc từ _MAX_ bản ghi)",
                    paginate: { first: "«", last: "»", previous: "‹", next: "›" },
                    zeroRecords: "Không tìm thấy kết quả"
                },
                pageLength: 20,
                lengthMenu: [10, 20, 50, 100],
                order: [[0, 'asc']],
                columnDefs: [{ orderable: false, targets: [2] }],
                deferRender: true,
                autoWidth: false,
                dom: '<"dt-toolbar"<"dt-length"l><"dt-search"f>>t<"dt-footer"<"dt-info"i><"dt-page"p>>',
                initComplete: function() {
                    let timer;
                    const input = $('.dataTables_filter input');
                    input.off('keyup.DT input.DT search.DT');
                    input.on('input', function() {
                        const val = this.value;
                        clearTimeout(timer);
                        timer = setTimeout(() => {
                            $('#mappingTable').DataTable().search(val).draw();
                        }, 220);
                    });
                }
            });
        });
    </script>
</body>
</html>