<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kết Quả</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/enterprise.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="https://app.hstatic.net/smes/uploads/63a4f573-85d8-4bc4-bf83-8b66b14ddc62.png" alt="Logo" height="32">
                <span>Inbound WMS</span>
            </a>
            <div class="d-flex align-items-center">
                <a href="/" class="btn btn-light btn-sm me-2">
                    <i class="bi bi-house me-1"></i>Trang chủ
                </a>
                <a href="/mapping" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-diagram-3 me-1"></i>Mapping
                </a>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <div class="page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <h1 class="page-title">Kết Quả Xử Lý</h1>
                <% if (result.SelectedWarehouse) { %>
                    <span class="warehouse-badge mt-1">
                        <i class="bi bi-building"></i>
                        <span><%= result.SelectedWarehouse.Name %> · <%= result.SelectedWarehouse.Code %></span>
                    </span>
                <% } %>
            </div>
            <a href="/" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Quay lại
            </a>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon primary"><i class="bi bi-list-ol"></i></div>
                    <div class="stat-number"><%= result.TotalRows %></div>
                    <div class="stat-label">Tổng dòng</div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon success"><i class="bi bi-check-circle"></i></div>
                    <div class="stat-number"><%= result.SuccessRows %></div>
                    <div class="stat-label">Thành công</div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon info"><i class="bi bi-box-seam"></i></div>
                    <div class="stat-number"><%= result.TotalSlThung.toLocaleString() %></div>
                    <div class="stat-label">Tổng SL Thùng</div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon warning"><i class="bi bi-tag"></i></div>
                    <div class="stat-number"><%= result.TotalSlGoiLe.toLocaleString() %></div>
                    <div class="stat-label">Tổng SL Gói Lẻ</div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="mb-0"><i class="bi bi-download me-2"></i>Xuất File Haravan</h6>
                <div class="d-flex flex-wrap gap-1">
                    <% result.XeList.forEach(function(xe) { %>
                        <a href="/download?xe=<%= encodeURIComponent(xe.XeName) %>" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-car-front-fill me-1"></i><%= xe.XeName %>
                        </a>
                    <% }); %>
                    <a href="/download" class="btn btn-success btn-sm">
                        <i class="bi bi-download me-1"></i>Tải tất cả
                    </a>
                </div>
            </div>
        </div>

        <% result.XeList.forEach(function(xe) { %>
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h6 class="mb-0">
                        <i class="bi bi-car-front-fill me-2"></i><%= xe.XeName %>
                    </h6>
                    <div>
                        <span class="badge bg-info me-2">Thùng: <%= xe.TotalSlThung %></span>
                        <span class="badge bg-warning">Gói lẻ: <%= xe.TotalSlGoiLe.toLocaleString() %></span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Mã gốc</th>
                                    <th>Tên</th>
                                    <th class="text-end">QC</th>
                                    <th class="text-end">SL</th>
                                    <th class="text-end">%Thùng</th>
                                    <th class="text-end">%Lẻ</th>
                                    <th class="text-end">SL Thùng</th>
                                    <th class="text-end">SL Gói Lẻ</th>
                                    <th>Mã final</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% xe.Items.forEach(function(item, index) { %>
                                    <tr>
                                        <td class="text-muted"><%= index + 1 %></td>
                                        <td><span class="code-badge"><%= item.Sku %></span></td>
                                        <td><%= item.Name %></td>
                                        <td class="text-end"><%= Math.round(item.QuyCach) %></td>
                                        <td class="text-end"><%= Math.round(item.SoLuong) %></td>
                                        <td class="text-end text-muted"><%= item.ThungPercent %>%</td>
                                        <td class="text-end text-muted"><%= item.LePercent %>%</td>
                                        <td class="text-end"><strong><%= Math.round(item.SlThung) %></strong></td>
                                        <td class="text-end"><strong class="text-primary"><%= Math.round(item.SlGoiLe) %></strong></td>
                                        <td><span class="code-badge"><%= item.FinalSku %></span></td>
                                        <td>
                                            <% if (item.Is3N && item.HasMapping) { %>
                                                <span class="badge badge-info">3N → 1N</span>
                                            <% } else if (item.Is3N && !item.HasMapping) { %>
                                                <span class="badge badge-warning">3N trực tiếp</span>
                                            <% } else { %>
                                                <span class="badge badge-success">OK</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% }); %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>